# ==============================================================================
# 3D ULPIN Generation & Vertical Property Mapping System (SIH26011)
# Environment Configuration Template
# 
# Instructions:
# 1. Copy this file to `.env` in the root directory:
#    cp .env.example .env   (Linux/macOS)
#    copy .env.example .env (Windows PowerShell: Copy-Item .env.example .env)
# 2. Update values according to your local development environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="3D ULPIN Backend"
APP_ENV="development"              # development | staging | production
DEBUG=true
HOST="127.0.0.1"
PORT=8000
LOG_LEVEL="INFO"                   # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ------------------------------------------------------------------------------
# 2. DATABASE & STORAGE
# ------------------------------------------------------------------------------
# Embedded SQLite WAL database location (zero daemon needed)
DB_PATH="./registry.db"

# Base directory for datasets (real, synthetic, exports)
DATA_DIR="./data"

# Sub-directories (relative to DATA_DIR or absolute paths)
REAL_DATA_DIR="./data/real"
SYNTHETIC_DATA_DIR="./data/synthetic"
EXPORTS_DIR="./data/exports"

# ------------------------------------------------------------------------------
# 3. FEDERATED JURISDICTION & NODE IDENTIFIER
# ------------------------------------------------------------------------------
# Federated issuing authority node ID (e.g., MH-MUMBAI-01 or KA-BENGALURU-01)
NODE_ID="MH-MUMBAI-NODE-01"

# State legal profile: MAHARASHTRA | KARNATAKA
# Controls legal validation rules (Apartment Act 1970 vs 1972, RERA rules)
STATE_LEGAL_PROFILE="MAHARASHTRA"

# Default Spatial Reference System (EPSG Code)
# 4326: WGS84 (Lat/Lon)
# 32643: UTM Zone 43N (Mumbai / Western India)
# 32644: UTM Zone 44N (Bengaluru / Southern India)
DEFAULT_CRS_EPSG=4326
MUMBAI_PROJECTED_EPSG=32643
BENGALURU_PROJECTED_EPSG=32644

# ------------------------------------------------------------------------------
# 4. TOLERANCE & GEOSPATIAL PARAMETERS
# ------------------------------------------------------------------------------
# Parcel area reconciliation tolerance (default: 0.05 = 5%, aligned with NAKSHA standard)
PARCEL_AREA_TOLERANCE=0.05

# 3D spatial intersection epsilon in meters (minimum overlap threshold)
SPATIAL_INTERSECTION_EPSILON_M=0.01

# Spatial Address (SA) Morton Grid Cell Level 0 in meters
MORTON_GRID_RESOLUTION_M=1.0

# ------------------------------------------------------------------------------
# 5. SECURITY & CORS (EXAMINER CONSOLE)
# ------------------------------------------------------------------------------
# Allowed origins for Examiner Web Console (JSON array string)
CORS_ORIGINS='["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:8000"]'

# Optional API Key for administrative / mutation endpoints (empty for dev mode)
API_KEY=""

# ------------------------------------------------------------------------------
# 6. EXTERNAL APIS & SURVEY CONTROL (OPTIONAL / MOCKABLE)
# ------------------------------------------------------------------------------
# Survey of India CORS Network Mock/Live Access Key
SOI_CORS_API_KEY=""

# OpenStreetMap / Overture Maps Data API Token (leave empty for public downloads)
OVERTURE_MAPS_API_KEY=""

# Mapbox / OpenStreetMap Basemap token for Examiner Console 3D viewer
MAPBOX_ACCESS_TOKEN=""
